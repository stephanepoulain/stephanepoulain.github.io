{% if site.email %}
  {% comment %}
    The address never appears in the page source: site.email may be written as name[dot]surname[at]domain,
    and both halves are stored reversed. The mailto link is assembled only when someone interacts with it.
  {% endcomment %}
  {% assign email_parts = site.email | replace: '[dot]', '.' | replace: '[at]', '@' | split: '@' %}
  <a
    href="#"
    class="email-link"
    title="email"
    aria-label="Email {{ site.first_name }} {{ site.last_name }}"
    data-u="{{ email_parts[0] | split: '' | reverse | join: '' }}"
    data-d="{{ email_parts[1] | split: '' | reverse | join: '' }}"
    ><i class="fa-solid fa-envelope" aria-hidden="true"></i
  ></a>
  <script>
    document.querySelectorAll('a.email-link').forEach(function (a) {
      function rev(s) {
        return s.split('').reverse().join('');
      }
      function arm() {
        a.href = 'mailto:' + rev(a.getAttribute('data-u')) + '@' + rev(a.getAttribute('data-d'));
      }
      ['mouseenter', 'focus', 'touchstart'].forEach(function (ev) {
        a.addEventListener(ev, arm, { once: true, passive: true });
      });
      a.addEventListener('click', arm);
    });
  </script>
{% endif %}
