<span class="short-bib">

  <!-- Title -->
  <span class="title">
    {%- if entry.doi -%}
      <a href="https://doi.org/{{ entry.doi }}"><em>{{ entry.title }}</em></a>
    {%- elsif entry.html -%}
      <a href="{{ entry.html }}"><em>{{ entry.title }}</em></a>
    {%- else -%}
      <em>{{ entry.title }}</em>
    {%- endif -%}
  </span>,

  <!-- Authors -->
  <span class="author">
    {% assign author_array_size = entry.author_array | size %}
    {% assign author_array_limit = author_array_size %}
    {% if site.max_author_limit and author_array_size > site.max_author_limit %}
      {% assign author_array_limit = site.max_author_limit %}
    {% endif %}

    {%- comment -%}
      Tags in this loop trim whitespace so no stray space lands before a comma.
      "A and B" for two authors, "A, B, and C" for three or more; a truncated list ends with ", and N more".
    {%- endcomment -%}
    {%- for author in entry.author_array limit: author_array_limit -%}
      {%- assign author_is_self = false -%}
      {%- assign author_last_name = author.last | remove: '¶' | remove: '&' | remove: '*' | remove: '†' | remove: '^' -%}
      {%- if site.scholar.last_name contains author_last_name -%}
        {%- if site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
      {%- endif -%}

      {%- assign coauthor_url = null -%}
      {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
      {%- if site.data.coauthors[clean_last_name] -%}
        {%- for coauthor in site.data.coauthors[clean_last_name] -%}
          {%- if coauthor.firstname contains author.first -%}
            {%- assign coauthor_url = coauthor.url -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- assign author_separator = '' -%}
      {%- unless forloop.first -%}
        {%- if author_array_limit < author_array_size -%}
          {%- assign author_separator = ', ' -%}
        {%- elsif forloop.length == 2 -%}
          {%- assign author_separator = ' and ' -%}
        {%- elsif forloop.last -%}
          {%- assign author_separator = ', and ' -%}
        {%- else -%}
          {%- assign author_separator = ', ' -%}
        {%- endif -%}
      {%- endunless -%}
      {{- author_separator -}}
      {%- if author_is_self -%}
        <strong>{{ author.first }} {{ author.last }}</strong>
      {%- elsif coauthor_url -%}
        <a href="{{ coauthor_url }}">{{ author.first }} {{ author.last }}</a>
      {%- else -%}
        {{- author.first }} {{ author.last -}}
      {%- endif -%}
    {%- endfor -%}

    {%- assign more_authors = author_array_size | minus: author_array_limit -%}
    {%- if more_authors > 0 -%}
      , and {{ more_authors }} more
    {%- endif -%}
  </span>,

  <!-- Journal, volume(number), pages + Year -->
  {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
  {% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
  {% assign entryvolume = entry.volume | strip %}
  {% assign entrynumber = entry.number | strip %}
  {% if entryvolume != "" and entrynumber != "" %}
    {% assign entryvolume = entryvolume | append: '(' | append: entrynumber | append: ')' %}
  {% endif %}
  {% assign entrypages = entry.pages | strip | replace: '--', '–' | replace: '-', '–' %}
  {% if entry.type == 'article' %}
    <span class="journal"><em>{{ entry.journal }}</em></span>,
  {% elsif proceedings contains entry.type %}
    <span class="journal"><em>In {{ entry.booktitle }}</em></span>,
  {% elsif thesis contains entry.type %}
    <span class="journal"><em>{{ entry.school }}</em></span>,
  {% endif %}
  {% if entryvolume != "" %}
    <span class="volume">{{ entryvolume }}</span>,
  {% endif %}
  {% if entrypages != "" %}
    <span class="pages">{{ entrypages }}</span>,
  {% endif %}
  {% if entry.year %}
    <span class="year">{{ entry.year }}</span>
  {% endif %}

  <!-- Links -->
  <span class="links">
    {% if entry.pdf %}
      <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="link">PDF<span class="sr-only">: {{ entry.title | strip }}</span></a>
    {% endif %}
  </span>
</span>
